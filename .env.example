# ── Web tier (Next.js) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Link the Python pipeline service (backend/) through /api/backend/*.
PIPELINE_BACKEND_URL=http://127.0.0.1:8000
# Shared with the FastAPI process; injected as X-Auth-Proxy-Secret server-side.
AUTH_PROXY_SECRET=my-secret-123
# Signed-in user's database role -> backend user id (never client-chosen).
# BACKEND_USER_MAP={"WRITER":1,"REVIEWER":2,"APPROVER":3}

# ── Identity (web tier) ─────────────────────────────────────────────────────
# HMAC key for signed session cookies. REQUIRED in production.
DOCLINE_SESSION_SECRET=my-secret-123
# Compose defaults to sso: trust X-Authenticated-User +
# X-Auth-Proxy-Secret from your SSO proxy. Use demo mode only for evaluations.
DOCLINE_AUTH_MODE=sso
SSO_PROXY_SECRET=my-secret-123

# GitHub webhook verification (push + pull_request events at POST /api/webhooks/github).
GITHUB_WEBHOOK_SECRET=
# GitHub App/fine-grained token with read access to source/docs and PR write
# access to documentation repositories. Required for production PR publishing.
# GITHUB_TOKEN=
# GITHUB_API_BASE=https://api.github.com

# github_pr is the production default. "database" is for local/demo publishing.
# PUBLISH_DESTINATION=github_pr

# Machine token for CI callers of POST /api/runs (Authorization: Bearer ...).
# PIPELINE_API_TOKEN=

# Compose requires an explicit Postgres password.
# POSTGRES_PASSWORD=

# Optional hosted-model drafting (server-side only, never sent to the browser).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Python tier (consumed by docker-compose): OLLAMA_URL, OLLAMA_URL_ALLOWLIST,
# PIPELINE_WEBHOOK_BRANCHES, PIPELINE_MAX_PROMPT_CHARS, PIPELINE_USE_GLOBAL_CONTEXT
# The webhook queue uses the Compose PostgreSQL service and POSTGRES_PASSWORD.
